# Copy this file to `.env` and fill in your key.
# `.env` is gitignored — it never gets committed.

GEMINI_API_KEY=

# Optional overrides.
# Tested 2026-08: 3.5-flash beat 3.1-pro on copy quality AND was 4x faster.
# Pro over-writes on emotional copy. Flash is the workhorse for every step.
# GEMINI_MODEL_FAST=gemini-3.5-flash
# GEMINI_MODEL_STRONG=gemini-3.5-flash
