# Copy this file to `.env` and fill in your key.
# `.env` is gitignored — it never gets committed.

GEMINI_API_KEY=

# Optional overrides.
# Tested 2026-08: 3.5-flash beat 3.1-pro on copy quality AND was 4x faster.
# Pro over-writes on emotional copy. Flash is the workhorse for every step.
# GEMINI_MODEL_FAST=gemini-3.5-flash
# GEMINI_MODEL_STRONG=gemini-3.5-flash

# Route hook scoring and captions to a local Ollama model instead of the API.
# OFF because it was measured and lost: only ~12% token saving (it handles the
# two cheapest calls), and on an identical 12-hook list qwen2.5:3b picked a hook
# it scored 5/10 over an 8.5/10 the API found. Its captions were unusable.
# Needs a bigger local model to be worth turning on. See TODO.md.
# USE_LOCAL_MODEL=1
